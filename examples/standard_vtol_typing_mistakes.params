# examples/standard_vtol_pusher_offset.params with two typing mistakes:
# the pusher offset has a decimal comma, and one parameter name has a letter too many.
# Expected: CA030 for the comma and CA031 for the name. Without these findings the report would
# look clean, because the pusher offset that causes CA010 and CA011 is not read.
CA_AIRFRAME 2
CA_ROTOR_COUNT 5
CA_ROTOR0_KM 0.05
CA_ROTOR0_PX 0.2
CA_ROTOR0_PY 0.2
CA_ROTOR1_KM 0.05
CA_ROTOR1_PX -0.2
CA_ROTOR1_PY -0.2
CA_ROTOR2_PX 0.2
CA_ROTOR2_PY -0.2
CA_ROTOR2_KM -0.05
CA_ROTOR3_PX -0.2
CA_ROTOR3_PYY 0.2
CA_ROTOR3_KM -0.05
CA_ROTOR4_PX -0.3
CA_ROTOR4_KM 0.05
CA_ROTOR4_AX 1
CA_ROTOR4_AZ 0
CA_SV_CS_COUNT 3
CA_SV_CS0_TRQ_R 1
CA_SV_CS0_TYPE 15
CA_SV_CS1_TRQ_P 1
CA_SV_CS1_TYPE 3
CA_SV_CS2_TRQ_Y 1
CA_SV_CS2_TYPE 4
CA_ROTOR4_PZ -0,05
