# A quadrotor where the axis of rotor 1 points down: CA_ROTOR1_AZ is 1, the
# default -1 is up.
# Expected: CA012 for motor1.
CA_AIRFRAME 0
CA_ROTOR_COUNT 4
CA_ROTOR0_PX 0.15
CA_ROTOR0_PY 0.15
CA_ROTOR0_KM 0.05
CA_ROTOR1_PX -0.15
CA_ROTOR1_PY -0.15
CA_ROTOR1_KM 0.05
CA_ROTOR1_AZ 1
CA_ROTOR2_PX 0.15
CA_ROTOR2_PY -0.15
CA_ROTOR2_KM -0.05
CA_ROTOR3_PX -0.15
CA_ROTOR3_PY 0.15
CA_ROTOR3_KM -0.05
